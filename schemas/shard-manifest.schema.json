{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asset-compound.dev/schemas/shard-manifest.schema.json",
  "title": "Small-context shard progress manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestHash",
    "runFingerprint",
    "maxChars",
    "maxItems",
    "totalAssets",
    "completedAssets",
    "assets",
    "shards"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "runFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "maxChars": {"type": "integer", "minimum": 32},
    "maxItems": {"type": "integer", "minimum": 1},
    "maxItemsMode": {"enum": ["auto", "fixed"]},
    "maxShards": {"type": "integer", "minimum": 1, "maximum": 1000},
    "totalAssets": {"type": "integer", "minimum": 0},
    "completedAssets": {"type": "integer", "minimum": 0},
    "assets": {"type": "array"},
    "gitScanPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxEffectiveCommits",
        "maxBusinessFilesPerCommit",
        "messageFiltersEnabled",
        "transactionalPathPatterns"
      ],
      "properties": {
        "maxEffectiveCommits": {"type": "integer", "minimum": 1},
        "maxBusinessFilesPerCommit": {"type": "integer", "minimum": 1},
        "messageFiltersEnabled": {"type": "boolean"},
        "transactionalPathPatterns": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "omittedRequirementSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "skippedFilesWithinCommit": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commit", "path", "reasonCode", "reason"],
        "properties": {
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "path": {"type": "string", "minLength": 1},
          "reasonCode": {"const": "per-commit-file-cap"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "skippedGitCommits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commit",
          "treeHash",
          "contentHash",
          "subject",
          "reasonCode",
          "reason",
          "files"
        ],
        "properties": {
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "treeHash": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "contentHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "subject": {"type": "string"},
          "reasonCode": {
            "enum": [
              "dependency-lockfile-only",
              "tool-config-only",
              "formatting-only",
              "message-transactional",
              "transactional-paths-only",
              "merge-noise",
              "revert-noise"
            ]
          },
          "reason": {"type": "string", "minLength": 1},
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shardId", "path", "assetIds", "inputHash", "status"],
        "properties": {
          "shardId": {"type": "string", "pattern": "^[0-9]{4,}$"},
          "path": {"type": "string", "pattern": "^shards/[0-9]+\\.json$"},
          "assetIds": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          },
          "inputHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "status": {"enum": ["pending", "completed"]},
          "validatedHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
